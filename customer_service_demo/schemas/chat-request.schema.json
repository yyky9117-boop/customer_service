{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:snack-customer-service:contracts:v1:chat-request",
  "title": "客服请求",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "conversation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 2000
    },
    "selected_reference": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "message_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "plan_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "sku_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "message_id",
            "plan_id",
            "sku_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "conversation_id",
    "request_id",
    "expected_revision",
    "message",
    "selected_reference"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "conversation_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "expected_revision": {
            "const": 0
          }
        }
      }
    }
  ]
}
